<Project>
  <PropertyGroup Condition="'$(Nullable)' == ''">
    <Nullable>enable</Nullable>
    <WarningsAsErrors Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">$(WarningsAsErrors);nullable</WarningsAsErrors>
    <NoWarn Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">$(NoWarn);nullable</NoWarn>
  </PropertyGroup>
</Project>
